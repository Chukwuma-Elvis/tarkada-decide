        <mxCell id="takarda" value="Takarda Results Platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="380" width="280" height="120" as="geometry" />
