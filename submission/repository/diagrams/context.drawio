              <mxPoint x="556" y="215" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e2" value="downloads result export&#10;for its candidates" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="school" target="takarda">
