        <mxCell id="payment" value="Payment Partner&#10;(external system, no idempotency support)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="700" width="260" height="100" as="geometry" />
