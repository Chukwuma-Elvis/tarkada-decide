        <mxCell id="e1" value="checks result; buys PIN&#10;(browser)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="candidate" target="takarda">
          <mxGeometry relative="1" as="geometry">
