        <mxCell id="telco" value="Telecom Aggregator&#10;(external system)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="230" height="100" as="geometry" />
