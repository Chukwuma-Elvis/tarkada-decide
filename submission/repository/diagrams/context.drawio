        <mxCell id="officer" value="Council Officer&#10;(person, internal user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="230" height="100" as="geometry" />
