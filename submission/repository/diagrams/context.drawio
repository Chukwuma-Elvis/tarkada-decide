        <mxCell id="regulator" value="Regulator / Council Board&#10;(person, oversight)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="700" width="230" height="100" as="geometry" />
