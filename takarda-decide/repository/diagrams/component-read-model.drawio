<mxfile host="app.diagrams.net">
  <diagram name="Component - Read-Model Builder" id="component1">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="boundary" value="Component: Read-Model Builder&#10;(the container most likely to be got wrong &#8212; reconciling &quot;instant, flat-cost reads&quot; with &quot;amendments must eventually be visible&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="1000" height="760" as="geometry" />
        </mxCell>

        <mxCell id="primarydb" value="Primary Database&#10;(external &#8212; read only here)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;shape=cylinder3;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="broker" value="Message Broker&#10;(external &#8212; amendment events)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="20" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cdn" value="Object Storage + CDN&#10;(external &#8212; write only here)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;shape=cylinder3;" vertex="1" parent="1">
          <mxGeometry x="380" y="930" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="scheduler" value="Refresh Scheduler&#10;(pre-release full build;&#10;post-release scheduled ticks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="consumer" value="Amendment Event Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="180" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dirtyset" value="Dirty-Set Tracker&#10;(which candidates/schools&#10;need regeneration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="320" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="candgen" value="Candidate Payload Generator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="schoolgen" value="School Export Generator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="480" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="checker" value="Consistency Checker&#10;(row-count sanity check&#10;before publish)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="630" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="publisher" value="Publisher&#10;(atomic / versioned write &#8212;&#10;never a partial payload goes live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="780" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="reads results&#10;+ enrollment" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="primarydb" target="candgen">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="112" y="450" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="c2" value="reads results&#10;+ enrollment" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="primarydb" target="schoolgen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="amendment events" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="1" source="broker" target="consumer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="marks candidate&#10;/ school dirty" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="consumer" target="dirtyset">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="full build (pre-release)&#10;or dirty-only (post-release)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;exitX=0.7;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="scheduler" target="dirtyset">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="which candidates&#10;to (re)generate" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dirtyset" target="candgen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="which schools&#10;to (re)generate" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dirtyset" target="schoolgen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="candgen" target="checker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c9" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="schoolgen" target="checker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="only if row counts&#10;match expectations" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="1" source="checker" target="publisher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="1" source="publisher" target="cdn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Deliberately left out: the specific queueing/backoff mechanism between the Amendment Event Consumer and the Dirty-Set Tracker, and the exact refresh-cycle interval (an operational tuning parameter, not an architectural one). What this diagram exists to show is the one seam in the whole system where &quot;flat-cost, instant reads&quot; (ADR-001) and &quot;amendments are never lost, never instant&quot; (ADR-002) meet &#8212; and where a careless implementation would either publish a half-built payload or silently drop an amendment." style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1000" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
